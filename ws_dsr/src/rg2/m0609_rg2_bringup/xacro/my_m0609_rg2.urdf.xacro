<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="m0609_rg2">

  <!-- M0609 URDF include -->
  <!-- <xacro:include filename="$(find dsr_description2)/urdf/m0609.urdf"/> -->
  <!-- <xacro:include filename="$(find dsr_description2)/xacro/m0609.urdf.xacro"/> -->
  <xacro:include filename="$(find m0609_rg2_bringup)/xacro/my_m0609.urdf.xacro"/>

  <link name="tool0"/>
  <joint name="joint_6-tool0" type="fixed">
    <origin rpy="3.1415926535 -1.570796327 0" xyz="0 0 0"/>
    <parent link="link_6"/>
    <child link="tool0"/>
  </joint>

  <!-- RG2 macro include -->
  <xacro:include filename="$(find m0609_rg2_bringup)/urdf/onrobot_rg2_model_macro.xacro"/>

  <!-- attaching RG2 Gripper to M0609 tool0 -->
  <xacro:onrobot_rg2 prefix="rg2_" effector_base="tool0"/>

</robot>