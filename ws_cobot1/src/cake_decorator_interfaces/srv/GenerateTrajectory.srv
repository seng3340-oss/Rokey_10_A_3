# 프론트엔드 캔버스 픽셀 좌표 → 로봇 3D 좌표 변환 서비스
# TM이 웹·브릿지에서 받은 원본 픽셀 좌표를 그대로 전달한다.
# DP 노드 내부에서 픽셀→mm 변환 후 좌표 계산을 수행한다.
# 케이크는 원통형(cylinder) — 반지름 하나 + 높이.

# ─── Request ───
string order_id                                     # 주문 ID
uint32 operation_speed_percent                      # 작업 속도 (0~100%)
cake_decorator_interfaces/Stroke2D[] strokes        # 획 데이터 (캔버스 픽셀 좌표)
string surface_type                                 # "TOP" 또는 "SIDE"
geometry_msgs/Pose cake_pose                        # 케이크 윗면 중심 절대 좌표 (TCP 기록, m)
float64 cake_radius                                 # 케이크 반지름 (m)
float64 cake_height                                 # 케이크 높이 (m)
float64 canvas_width                                # 캔버스 가로 크기 (px)
float64 canvas_height                               # 캔버스 세로 크기 (px)

# DP → TM. 위치 m·자세 쿼터니언의 경로를 반환한다.
bool success
cake_decorator_interfaces/Waypoint3D[] waypoints_3d
# waypoints_3d[i].pen_down과 길이·값이 일치해야 한다.
bool[] pen_states
float64 estimated_duration_sec
string error_msg