# 핵심 로직 함수 (Node 없이 직접 테스트)
# =====================================================================
# Node를 생성하지 않고 변환 로직만 추출해서 테스트한다.


def _extract_points(stroke) -> list[tuple[float, float]]:
    """DrawingPathNode._extract_points 로직 복제."""
    if stroke.target_mm:
        return [(pt.x, pt.y) for pt in stroke.target_mm]
    if stroke.simplified_mm:
        return [(pt.x, pt.y) for pt in stroke.simplified_mm]
    if stroke.original_mm:
        return [(pt.x, pt.y) for pt in stroke.original_mm]
    return []


def _wp(x_mm, y_mm, z_mm, quat, speed, force):
    """DrawingPathNode._wp 로직 복제."""
    Waypoint3D = _mocks['Waypoint3D']
    Pose = _mocks['Pose']
    Point = _mocks['Point']
    Quaternion = _mocks['Quaternion']

    msg = Waypoint3D()
    msg.pose = Pose(
        position=Point(x=x_mm / 1000.0, y=y_mm / 1000.0, z=z_mm / 1000.0),
        orientation=Quaternion(x=quat[0], y=quat[1], z=quat[2], w=quat[3]),
    )
    msg.speed = speed
    msg.pen_down = False
    msg.contact_force = force
    return msg


def _convert_stroke_top(pts, cake, approach_h, z_offset, draw_spd, travel_spd, force):
    """DrawingPathNode._convert_stroke_top 로직 복제."""
    from cake_decorator.drawing_geometry import pen_quat_top
    quat = pen_quat_top()
    waypoints = []
    pen_states = []

    fx, fy, fz = cake.top_to_abs(pts[0][0], pts[0][1])
    waypoints.append(_wp(fx, fy, fz + approach_h, quat, travel_spd, force))
    pen_states.append(False)

    waypoints.append(_wp(fx, fy, fz + z_offset, quat, draw_spd * 0.5, force))
    pen_states.append(True)

    for pt in pts[1:]:
        ax, ay, az = cake.top_to_abs(pt[0], pt[1])
        waypoints.append(_wp(ax, ay, az + z_offset, quat, draw_spd, force))
        pen_states.append(True)

    lx, ly, lz = cake.top_to_abs(pts[-1][0], pts[-1][1])
    waypoints.append(_wp(lx, ly, lz + approach_h, quat, travel_spd, force))
    pen_states.append(False)

    return waypoints, pen_states


def _convert_stroke_side(pts, cake, approach_h, z_offset, draw_spd, travel_spd, force):
    """DrawingPathNode._convert_stroke_side 로직 복제."""
    from cake_decorator.drawing_geometry import pen_quat_side
    waypoints = []
    pen_states = []

    x0, y0 = pts[0][0], pts[0][1]
    quat0 = pen_quat_side(x0, y0, cake)
    ax0, ay0, az0 = cake.side_abs_with_offset(x0, y0, approach_h)
    waypoints.append(_wp(ax0, ay0, az0, quat0, travel_spd, force))
    pen_states.append(False)

    cx0, cy0, cz0 = cake.side_abs_with_offset(x0, y0, z_offset)
    waypoints.append(_wp(cx0, cy0, cz0, quat0, draw_spd * 0.5, force))
    pen_states.append(True)

    for pt in pts[1:]:
        xi, yi = pt[0], pt[1]
        qi = pen_quat_side(xi, yi, cake)
        cxi, cyi, czi = cake.side_abs_with_offset(xi, yi, z_offset)
        waypoints.append(_wp(cxi, cyi, czi, qi, draw_spd, force))
        pen_states.append(True)

    xn, yn = pts[-1][0], pts[-1][1]
    quatn = pen_quat_side(xn, yn, cake)
    axn, ayn, azn = cake.side_abs_with_offset(xn, yn, approach_h)
    waypoints.append(_wp(axn, ayn, azn, quatn, travel_spd, force))
    pen_states.append(False)

    return waypoints, pen_states


def _estimate_duration(waypoints):
    """DrawingPathNode._estimate_duration 로직 복제."""
    if len(waypoints) < 2:
        return 0.0
    total = 0.0
    for i in range(1, len(waypoints)):
        p = waypoints[i - 1].pose.position
        c = waypoints[i].pose.position
        dist = math.sqrt(
            (c.x - p.x) ** 2 + (c.y - p.y) ** 2 + (c.z - p.z) ** 2,
        )
        speed_m_s = waypoints[i].speed / 1000.0
        if speed_m_s > 0:
            total += dist / speed_m_s
    return total