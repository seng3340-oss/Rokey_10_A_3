"""drawing_path_node.py 테스트 — 원통형(cylinder) 경로 변환.

ROS 의존성을 mock하여 pytest로 실행 가능.
  pytest test_drawing_path_node.py -v

핵심 변환 로직을 Node 없이 직접 테스트한다.
(Node 생성은 ROS 초기화가 필요하므로 static 함수만 복제·검증)
"""

from __future__ import annotations

import math
import sys
from dataclasses import dataclass, field
from types import ModuleType
from unittest.mock import MagicMock

import pytest


# =====================================================================
# ROS mock 설정
# =====================================================================


def _setup_ros_mocks():
    """ROS2 패키지를 mock으로 대체."""

    @dataclass
    class MockPoint:
        x: float = 0.0
        y: float = 0.0
        z: float = 0.0

    @dataclass
    class MockQuaternion:
        x: float = 0.0
        y: float = 0.0
        z: float = 0.0
        w: float = 1.0

    @dataclass
    class MockPose:
        position: MockPoint = field(default_factory=MockPoint)
        orientation: MockQuaternion = field(default_factory=MockQuaternion)

    geometry_msgs_msg = ModuleType('geometry_msgs.msg')
    geometry_msgs_msg.Point = MockPoint
    geometry_msgs_msg.Quaternion = MockQuaternion
    geometry_msgs_msg.Pose = MockPose
    sys.modules['geometry_msgs'] = ModuleType('geometry_msgs')
    sys.modules['geometry_msgs.msg'] = geometry_msgs_msg

    @dataclass
    class MockWaypoint3D:
        pose: MockPose = field(default_factory=MockPose)
        speed: float = 0.0
        pen_down: bool = False
        contact_force: float = 0.0

    @dataclass
    class MockPoint2D:
        x: float = 0.0
        y: float = 0.0

    @dataclass
    class MockStroke2D:
        stroke_id: str = ''
        color: str = ''
        points: list = field(default_factory=list)

    class MockGenerateTrajectory:
        class Request:
            pass
        class Response:
            def __init__(self):
                self.success = False
                self.waypoints_3d = []
                self.pen_states = []
                self.estimated_duration_sec = 0.0
                self.error_msg = ''

    interfaces_msg = ModuleType('cake_decorator_interfaces.msg')
    interfaces_msg.Waypoint3D = MockWaypoint3D
    interfaces_msg.Point2D = MockPoint2D
    interfaces_msg.Stroke2D = MockStroke2D

    interfaces_srv = ModuleType('cake_decorator_interfaces.srv')
    interfaces_srv.GenerateTrajectory = MockGenerateTrajectory

    sys.modules['cake_decorator_interfaces'] = ModuleType('cake_decorator_interfaces')
    sys.modules['cake_decorator_interfaces.msg'] = interfaces_msg
    sys.modules['cake_decorator_interfaces.srv'] = interfaces_srv

    mock_rclpy = MagicMock()
    sys.modules['rclpy'] = mock_rclpy
    sys.modules['rclpy.node'] = MagicMock()

    return {
        'Point': MockPoint,
        'Quaternion': MockQuaternion,
        'Pose': MockPose,
        'Waypoint3D': MockWaypoint3D,
        'Point2D': MockPoint2D,
        'Stroke2D': MockStroke2D,
        'GenerateTrajectory': MockGenerateTrajectory,
    }


_mocks = _setup_ros_mocks()

from drawing_geometry import (
    CylinderCake,
    pen_quat_side,
    pen_quat_top,
    pixel_to_mm_side,
    pixel_to_mm_top,
)


# =====================================================================
# 핵심 로직 함수 복제 (Node 없이 테스트)
# =====================================================================


def _wp(x_mm, y_mm, z_mm, quat, speed, force):
    """DrawingPathNode._wp 로직 복제."""
    msg = _mocks['Waypoint3D']()
    msg.pose = _mocks['Pose'](
        position=_mocks['Point'](x=x_mm / 1000.0, y=y_mm / 1000.0, z=z_mm / 1000.0),
        orientation=_mocks['Quaternion'](x=quat[0], y=quat[1], z=quat[2], w=quat[3]),
    )
    msg.speed = speed
    msg.pen_down = False
    msg.contact_force = force
    return msg


def _convert_stroke_top(
    pts_px, cake, canvas_w, canvas_h,
    approach_h, z_offset, draw_spd, travel_spd, force, tilt_deg=30.0,
):
    """DrawingPathNode._convert_stroke_top 로직 복제."""
    quat = pen_quat_top(tilt_deg=tilt_deg)
    waypoints, pen_states = [], []

    mm_x, mm_y = pixel_to_mm_top(pts_px[0][0], pts_px[0][1], canvas_w, canvas_h, cake.radius)
    fx, fy, fz = cake.top_to_abs(mm_x, mm_y)
    waypoints.append(_wp(fx, fy, fz + approach_h, quat, travel_spd, force))
    pen_states.append(False)

    waypoints.append(_wp(fx, fy, fz + z_offset, quat, draw_spd * 0.5, force))
    pen_states.append(True)

    for px_x, px_y in pts_px[1:]:
        mx, my = pixel_to_mm_top(px_x, px_y, canvas_w, canvas_h, cake.radius)
        ax, ay, az = cake.top_to_abs(mx, my)
        waypoints.append(_wp(ax, ay, az + z_offset, quat, draw_spd, force))
        pen_states.append(True)

    lmx, lmy = pixel_to_mm_top(pts_px[-1][0], pts_px[-1][1], canvas_w, canvas_h, cake.radius)
    lx, ly, lz = cake.top_to_abs(lmx, lmy)
    waypoints.append(_wp(lx, ly, lz + approach_h, quat, travel_spd, force))
    pen_states.append(False)

    return waypoints, pen_states


def _convert_stroke_side(
    pts_px, cake, canvas_w, canvas_h,
    approach_h, z_offset, draw_spd, travel_spd, force, tilt_deg=30.0,
):
    """DrawingPathNode._convert_stroke_side 로직 복제."""
    waypoints, pen_states = [], []

    arc0, h0 = pixel_to_mm_side(pts_px[0][0], pts_px[0][1], canvas_w, canvas_h, cake.radius, cake.height)
    quat0 = pen_quat_side(arc0, cake, tilt_deg=tilt_deg)
    ax0, ay0, az0 = cake.side_abs_with_offset(arc0, h0, approach_h)
    waypoints.append(_wp(ax0, ay0, az0, quat0, travel_spd, force))
    pen_states.append(False)

    cx0, cy0, cz0 = cake.side_abs_with_offset(arc0, h0, z_offset)
    waypoints.append(_wp(cx0, cy0, cz0, quat0, draw_spd * 0.5, force))
    pen_states.append(True)

    for px_x, px_y in pts_px[1:]:
        arc_i, h_i = pixel_to_mm_side(px_x, px_y, canvas_w, canvas_h, cake.radius, cake.height)
        qi = pen_quat_side(arc_i, cake, tilt_deg=tilt_deg)
        cxi, cyi, czi = cake.side_abs_with_offset(arc_i, h_i, z_offset)
        waypoints.append(_wp(cxi, cyi, czi, qi, draw_spd, force))
        pen_states.append(True)

    arcn, hn = pixel_to_mm_side(pts_px[-1][0], pts_px[-1][1], canvas_w, canvas_h, cake.radius, cake.height)
    quatn = pen_quat_side(arcn, cake, tilt_deg=tilt_deg)
    axn, ayn, azn = cake.side_abs_with_offset(arcn, hn, approach_h)
    waypoints.append(_wp(axn, ayn, azn, quatn, travel_spd, force))
    pen_states.append(False)

    return waypoints, pen_states


def _estimate_duration(waypoints):
    if len(waypoints) < 2:
        return 0.0
    total = 0.0
    for i in range(1, len(waypoints)):
        p = waypoints[i - 1].pose.position
        c = waypoints[i].pose.position
        dist = math.sqrt((c.x - p.x)**2 + (c.y - p.y)**2 + (c.z - p.z)**2)
        speed_m_s = waypoints[i].speed / 1000.0
        if speed_m_s > 0:
            total += dist / speed_m_s
    return total


