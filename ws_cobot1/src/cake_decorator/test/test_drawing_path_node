class TestExtractPoints:
    """스트로크에서 좌표 추출 우선순위 테스트."""

    def test_target_mm_priority(self, mocks):
        """target_mm이 있으면 최우선."""
        StrokeMM = mocks['StrokeMM']
        PointMM = mocks['PointMM']
        PointMM3D = mocks['PointMM3D']

        stroke = StrokeMM(
            original_mm=[PointMM(1, 2), PointMM(3, 4)],
            simplified_mm=[PointMM(5, 6)],
            target_mm=[PointMM3D(10, 20, 30), PointMM3D(40, 50, 60)],
        )

        pts = _extract_points(stroke)
        assert len(pts) == 2
        assert pts[0] == (10.0, 20.0)
        assert pts[1] == (40.0, 50.0)

    def test_simplified_mm_fallback(self, mocks):
        """target_mm 없으면 simplified_mm."""
        StrokeMM = mocks['StrokeMM']
        PointMM = mocks['PointMM']

        stroke = StrokeMM(
            original_mm=[PointMM(1, 2)],
            simplified_mm=[PointMM(5, 6), PointMM(7, 8)],
            target_mm=[],
        )

        pts = _extract_points(stroke)
        assert len(pts) == 2
        assert pts[0] == (5.0, 6.0)

    def test_original_mm_fallback(self, mocks):
        """둘 다 없으면 original_mm."""
        StrokeMM = mocks['StrokeMM']
        PointMM = mocks['PointMM']

        stroke = StrokeMM(
            original_mm=[PointMM(1, 2), PointMM(3, 4)],
            simplified_mm=[],
            target_mm=[],
        )

        pts = _extract_points(stroke)
        assert len(pts) == 2
        assert pts[0] == (1.0, 2.0)

    def test_empty_stroke(self, mocks):
        """모두 비어있으면 빈 리스트."""
        stroke = mocks['StrokeMM']()
        pts = _extract_points(stroke)
        assert pts == []


