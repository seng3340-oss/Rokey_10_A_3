class TestEstimateDuration:

    def test_empty(self):
        assert _estimate_duration([]) == pytest.approx(0.0)

    def test_single(self):
        wp = _mocks['Waypoint3D'](
            pose=_mocks['Pose'](position=_mocks['Point'](0, 0, 0)), speed=20.0,
        )
        assert _estimate_duration([wp]) == pytest.approx(0.0)

    def test_straight_line(self):
        """0.1m 이동, 100mm/s → 1초."""
        wp1 = _mocks['Waypoint3D'](
            pose=_mocks['Pose'](position=_mocks['Point'](0, 0, 0)), speed=100.0,
        )
        wp2 = _mocks['Waypoint3D'](
            pose=_mocks['Pose'](position=_mocks['Point'](0.1, 0, 0)), speed=100.0,
        )
        assert _estimate_duration([wp1, wp2]) == pytest.approx(1.0)

    def test_multiple_segments(self):
        """구간1: 0.1m@100mm/s→1s, 구간2: 0.2m@200mm/s→1s = 2s."""
        wp1 = _mocks['Waypoint3D'](pose=_mocks['Pose'](position=_mocks['Point'](0, 0, 0)), speed=100.0)
        wp2 = _mocks['Waypoint3D'](pose=_mocks['Pose'](position=_mocks['Point'](0.1, 0, 0)), speed=100.0)
        wp3 = _mocks['Waypoint3D'](pose=_mocks['Pose'](position=_mocks['Point'](0.3, 0, 0)), speed=200.0)
        assert _estimate_duration([wp1, wp2, wp3]) == pytest.approx(2.0)


