class TestEstimateDuration:
    """소요 시간 추정 테스트."""

    def test_empty(self, mocks):
        """빈 웨이포인트 → 0초."""
        assert _estimate_duration([]) == pytest.approx(0.0)

    def test_single(self, mocks):
        """웨이포인트 1개 → 0초."""
        Waypoint3D = mocks['Waypoint3D']
        Pose = mocks['Pose']
        Point = mocks['Point']
        wp = Waypoint3D(pose=Pose(position=Point(0, 0, 0)), speed=20.0)
        assert _estimate_duration([wp]) == pytest.approx(0.0)

    def test_straight_line(self, mocks):
        """직선 이동: 거리 / 속도."""
        Waypoint3D = mocks['Waypoint3D']
        Pose = mocks['Pose']
        Point = mocks['Point']

        # 0.1m 이동, 속도 100mm/s = 0.1m/s → 1초
        wp1 = Waypoint3D(pose=Pose(position=Point(0, 0, 0)), speed=100.0)
        wp2 = Waypoint3D(pose=Pose(position=Point(0.1, 0, 0)), speed=100.0)

        duration = _estimate_duration([wp1, wp2])
        assert duration == pytest.approx(1.0)

    def test_multiple_segments(self, mocks):
        """여러 구간 합산."""
        Waypoint3D = mocks['Waypoint3D']
        Pose = mocks['Pose']
        Point = mocks['Point']

        # 구간1: 0.1m, 100mm/s → 1s
        # 구간2: 0.2m, 200mm/s → 1s
        wp1 = Waypoint3D(pose=Pose(position=Point(0, 0, 0)), speed=100.0)
        wp2 = Waypoint3D(pose=Pose(position=Point(0.1, 0, 0)), speed=100.0)
        wp3 = Waypoint3D(pose=Pose(position=Point(0.3, 0, 0)), speed=200.0)

        duration = _estimate_duration([wp1, wp2, wp3])
        assert duration == pytest.approx(2.0)


