# 케이크: 반지름 100mm, 높이 80mm, 바닥 중심 (300, 200, 50)
CAKE = CylinderCake(radius=100.0, height=80.0, cx=300.0, cy=200.0, cz=50.0)
CANVAS_W, CANVAS_H = 500.0, 500.0  # TOP용 정사각형 캔버스
SIDE_CANVAS_W, SIDE_CANVAS_H = 628.0, 400.0  # SIDE용


# =====================================================================
# TOP 면 변환 테스트
# =====================================================================


class TestTopConversion:

    def test_waypoint_count_3pts(self):
        """3점 → 접근 + 접촉 + 2 그리기 + 이탈 = 5."""
        pts = [(250, 250), (260, 250), (270, 250)]
        wp, ps = _convert_stroke_top(pts, CAKE, CANVAS_W, CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        assert len(wp) == 5
        assert len(ps) == 5

    def test_pen_states_pattern(self):
        """False, True, True, ..., False."""
        pts = [(250, 250), (260, 250), (270, 250)]
        _, ps = _convert_stroke_top(pts, CAKE, CANVAS_W, CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        assert ps[0] is False
        assert ps[1] is True
        assert ps[2] is True
        assert ps[3] is True
        assert ps[4] is False

    def test_center_pixel_maps_to_cake_center(self):
        """캔버스 중심 → 케이크 윗면 중심."""
        pts = [(250, 250)]
        wp, _ = _convert_stroke_top(pts, CAKE, CANVAS_W, CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        # 케이크 윗면 중심: (300, 200, 130) mm → m
        # 접촉점 (index 1)
        assert wp[1].pose.position.x == pytest.approx(0.3)
        assert wp[1].pose.position.y == pytest.approx(0.2)
        assert wp[1].pose.position.z == pytest.approx(0.13)  # (50+80)/1000

    def test_approach_height(self):
        """접근 Z = 윗면 + approach_h."""
        pts = [(250, 250)]
        wp, _ = _convert_stroke_top(pts, CAKE, CANVAS_W, CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        # 접근 Z = (130 + 10) / 1000 = 0.14
        assert wp[0].pose.position.z == pytest.approx(0.14)

    def test_z_offset(self):
        """접촉 Z = 윗면 + z_offset."""
        pts = [(250, 250)]
        wp, _ = _convert_stroke_top(pts, CAKE, CANVAS_W, CANVAS_H, 10.0, -1.0, 20.0, 80.0, 0.5)
        # 접촉 Z = (130 + (-1)) / 1000 = 0.129
        assert wp[1].pose.position.z == pytest.approx(0.129)

    def test_speeds(self):
        """접근/이탈=travel, 접촉=draw*0.5, 그리기=draw."""
        pts = [(250, 250), (260, 250)]
        wp, _ = _convert_stroke_top(pts, CAKE, CANVAS_W, CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        assert wp[0].speed == pytest.approx(80.0)   # 접근
        assert wp[1].speed == pytest.approx(10.0)    # 접촉
        assert wp[2].speed == pytest.approx(20.0)    # 그리기
        assert wp[3].speed == pytest.approx(80.0)    # 이탈

    def test_pixel_to_abs_x_direction(self):
        """캔버스 오른쪽 → 절대 +X."""
        # 캔버스 오른쪽 끝 (500, 250) → mm_x = +100
        pts = [(500, 250)]
        wp, _ = _convert_stroke_top(pts, CAKE, CANVAS_W, CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        # 절대 X = 300 + 100 = 400mm → 0.4m
        assert wp[1].pose.position.x == pytest.approx(0.4)

    def test_pixel_to_abs_y_inverted(self):
        """캔버스 위쪽 → 절대 +Y (반전)."""
        # 캔버스 위쪽 (250, 0) → mm_y = +100
        pts = [(250, 0)]
        wp, _ = _convert_stroke_top(pts, CAKE, CANVAS_W, CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        # 절대 Y = 200 + 100 = 300mm → 0.3m
        assert wp[1].pose.position.y == pytest.approx(0.3)


# =====================================================================
# SIDE 면 변환 테스트
