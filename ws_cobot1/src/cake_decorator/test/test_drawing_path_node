class TestMultiStroke:

    def test_two_strokes_top(self):
        """TOP 2획 → 각각 접근/접촉/그리기/이탈."""
        strokes = [
            [(200, 250), (250, 250)],
            [(300, 250), (350, 250)],
        ]
        all_wp, all_pen = [], []
        for pts in strokes:
            wp, ps = _convert_stroke_top(pts, CAKE, CANVAS_W, CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
            all_wp.extend(wp)
            all_pen.extend(ps)

        assert len(all_wp) == 8  # 4 + 4
        assert all_pen[0] is False
        assert all_pen[3] is False
        assert all_pen[4] is False
        assert all_pen[7] is False

    def test_mixed_top_side(self):
        """TOP + SIDE 혼합: orientation이 다름."""
        pts_top = [(250, 250), (260, 250)]
        pts_side = [(0, 200), (100, 200)]

        wp_top, _ = _convert_stroke_top(pts_top, CAKE, CANVAS_W, CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        wp_side, _ = _convert_stroke_side(pts_side, CAKE, SIDE_CANVAS_W, SIDE_CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)

        q_top = wp_top[1].pose.orientation
        q_side = wp_side[1].pose.orientation
        assert (q_top.x, q_top.y, q_top.z, q_top.w) != (q_side.x, q_side.y, q_side.z, q_side.w)


# =====================================================================
# 윗면→바닥 중심 변환 통합 테스트
# =====================================================================


class TestCenterConversion:
    """TCP 윗면 중심 → 바닥 중심 변환 (DP가 하는 것) 검증."""

    def test_conversion(self):
        """윗면 중심 (500, 300, 280)mm, 높이 80mm → 바닥 (500, 300, 200)mm."""
        top_z = 280.0
        height = 80.0
        bottom_z = top_z - height

        cake = CylinderCake(radius=100.0, height=height, cx=500.0, cy=300.0, cz=bottom_z)

        # 윗면 확인
        _, _, z_top = cake.top_to_abs(0, 0)
        assert pytest.approx(z_top) == 280.0

        # 바닥 확인
        _, _, z_bot = cake.side_to_abs(0, 0)  # h=0 = 바닥
        assert pytest.approx(z_bot) == 200.0


