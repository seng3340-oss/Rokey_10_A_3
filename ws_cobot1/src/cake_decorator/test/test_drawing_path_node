class TestSideConversion:

    def test_waypoint_count(self):
        pts = [(0, 200), (100, 200), (200, 200)]
        wp, ps = _convert_stroke_side(pts, CAKE, SIDE_CANVAS_W, SIDE_CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        assert len(wp) == 5

    def test_pen_states(self):
        pts = [(0, 200), (100, 200)]
        _, ps = _convert_stroke_side(pts, CAKE, SIDE_CANVAS_W, SIDE_CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        assert ps[0] is False
        assert ps[1] is True
        assert ps[2] is True
        assert ps[3] is False

    def test_arc_zero_approach(self):
        """arc=0 → 법선 +X 방향, 접근은 더 바깥."""
        pts = [(0, 200)]  # arc=0, h=중간
        wp, _ = _convert_stroke_side(pts, CAKE, SIDE_CANVAS_W, SIDE_CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        # 접근 X = (300 + 100 + 10) / 1000 = 0.41
        assert wp[0].pose.position.x == pytest.approx(0.41)

    def test_arc_zero_contact(self):
        """arc=0 → 접촉점은 표면 위."""
        pts = [(0, 200)]
        wp, _ = _convert_stroke_side(pts, CAKE, SIDE_CANVAS_W, SIDE_CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        # 접촉 X = (300 + 100) / 1000 = 0.4
        assert wp[1].pose.position.x == pytest.approx(0.4)

    def test_cylinder_consistent_radius(self):
        """원통형: 높이 달라도 표면 X 동일 (arc=0)."""
        pts_top = [(0, 0)]     # h = cake_height (윗쪽)
        pts_bot = [(0, 400)]   # h = 0 (바닥)
        wp_top, _ = _convert_stroke_side(pts_top, CAKE, SIDE_CANVAS_W, SIDE_CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        wp_bot, _ = _convert_stroke_side(pts_bot, CAKE, SIDE_CANVAS_W, SIDE_CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        assert wp_top[1].pose.position.x == pytest.approx(wp_bot[1].pose.position.x)

    def test_orientation_varies_by_arc(self):
        """다른 arc → 다른 orientation."""
        pts = [(0, 200), (200, 200)]
        wp, _ = _convert_stroke_side(pts, CAKE, SIDE_CANVAS_W, SIDE_CANVAS_H, 10.0, 0.0, 20.0, 80.0, 0.5)
        q1 = wp[1].pose.orientation
        q2 = wp[2].pose.orientation
        assert (q1.x, q1.y, q1.z, q1.w) != (q2.x, q2.y, q2.z, q2.w)


