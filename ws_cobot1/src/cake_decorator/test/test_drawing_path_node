class TestTopConversion:
    """TOP 면 웨이포인트 생성 테스트."""

    def test_top_waypoint_count(self, frustum_cake, mocks):
        """단일 획(3점) → 웨이포인트 5개 (접근+접촉+2점+이탈)."""
        pts = [(0, 0), (10, 0), (20, 0)]
        waypoints, pen_states = _convert_stroke_top(
            pts, frustum_cake,
            approach_h=10.0, z_offset=0.0,
            draw_spd=20.0, travel_spd=80.0, force=0.5,
        )
        # 접근(1) + 접촉(1) + 나머지(2) + 이탈(1) = 5
        assert len(waypoints) == 5
        assert len(pen_states) == 5

    def test_top_pen_states(self, frustum_cake, mocks):
        """TOP: False, True, True, ..., False 패턴."""
        pts = [(0, 0), (10, 0), (20, 0)]
        _, pen_states = _convert_stroke_top(
            pts, frustum_cake,
            approach_h=10.0, z_offset=0.0,
            draw_spd=20.0, travel_spd=80.0, force=0.5,
        )
        assert pen_states[0] is False   # 접근
        assert pen_states[1] is True    # 접촉
        assert pen_states[2] is True    # 그리기
        assert pen_states[3] is True    # 그리기
        assert pen_states[4] is False   # 이탈

    def test_top_z_approach(self, frustum_cake, mocks):
        """접근 위치 Z = 윗면 + approach_height."""
        pts = [(0, 0)]
        waypoints, _ = _convert_stroke_top(
            pts, frustum_cake,
            approach_h=10.0, z_offset=0.0,
            draw_spd=20.0, travel_spd=80.0, force=0.5,
        )
        # 윗면 Z = 50 + 100 = 150mm → m = 0.15
        # 접근 Z = (150 + 10) / 1000 = 0.16
        assert waypoints[0].pose.position.z == pytest.approx(0.16)

    def test_top_z_contact(self, frustum_cake, mocks):
        """접촉 위치 Z = 윗면 + z_offset."""
        pts = [(0, 0)]
        waypoints, _ = _convert_stroke_top(
            pts, frustum_cake,
            approach_h=10.0, z_offset=-0.5,
            draw_spd=20.0, travel_spd=80.0, force=0.5,
        )
        # 접촉 Z = (150 + (-0.5)) / 1000 = 0.1495
        assert waypoints[1].pose.position.z == pytest.approx(0.1495)

    def test_top_xy_absolute(self, frustum_cake, mocks):
        """TOP: XY = cake_center + offset → m 단위."""
        pts = [(10, -5)]
        waypoints, _ = _convert_stroke_top(
            pts, frustum_cake,
            approach_h=10.0, z_offset=0.0,
            draw_spd=20.0, travel_spd=80.0, force=0.5,
        )
        # cake_x=300, pt_x=10 → 310mm → 0.31m
        assert waypoints[0].pose.position.x == pytest.approx(0.31)
        # cake_y=200, pt_y=-5 → 195mm → 0.195m
        assert waypoints[0].pose.position.y == pytest.approx(0.195)

    def test_top_speeds(self, frustum_cake, mocks):
        """접근/이탈 = travel_speed, 접촉 = draw*0.5, 그리기 = draw."""
        pts = [(0, 0), (10, 0)]
        waypoints, _ = _convert_stroke_top(
            pts, frustum_cake,
            approach_h=10.0, z_offset=0.0,
            draw_spd=20.0, travel_spd=80.0, force=0.5,
        )
        assert waypoints[0].speed == pytest.approx(80.0)   # 접근
        assert waypoints[1].speed == pytest.approx(10.0)    # 접촉 (20*0.5)
        assert waypoints[2].speed == pytest.approx(20.0)    # 그리기
        assert waypoints[3].speed == pytest.approx(80.0)    # 이탈


