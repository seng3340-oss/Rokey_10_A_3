<?xml version="1.0"?>
<package format="3">
  <name>cake_decorator</name>
  <version>0.1.0</version>
  <description>케이크 주문 브릿지·작업 실행과 읽기 전용 HMI 상태 전달.</description>
  <maintainer email="applewlghks321@gmail.com">Cake project team</maintainer>
  <license>MIT</license>

  <!-- Python 패키지를 설치하며 기존 인터페이스 패키지를 참조한다. -->
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>dsr_msgs2</exec_depend>
  <exec_depend>cake_decorator_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
