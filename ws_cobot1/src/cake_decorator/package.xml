<?xml version="1.0"?>
<package format="3">
  <name>cake_decorator</name>
  <version>0.1.0</version>
  <description>케이크 ROS 업무 노드 개발을 위한 파일 구조. 실행 기능은 미구현.</description>
  <maintainer email="applewlghks321@gmail.com">Cake project team</maintainer>
  <license>MIT</license>

  <!-- Python 패키지를 설치하며 기존 인터페이스 패키지를 참조한다. -->
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>cake_decorator_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
